    <script>
        let currentSport = 'Sepak Bola';

        // Load saved API Key on load
        window.addEventListener('DOMContentLoaded', () => {
            const savedKey = localStorage.getItem('arena_api_key');
            const savedProvider = localStorage.getItem('arena_api_provider') || 'gemini';
            document.getElementById('api-provider').value = savedProvider;
            if(savedKey) {
                document.getElementById('user-api-key').value = savedKey;
                updateKeyStatusBadge(true);
            } else {
                updateKeyStatusBadge(false);
            }
        });

        function toggleKeyModal() {
            document.getElementById('api-modal').classList.toggle('hidden');
        }

        function togglePasswordVisibility() {
            const keyInput = document.getElementById('user-api-key');
            const eyeIcon = document.getElementById('eye-icon');
            if(keyInput.type === 'password') {
                keyInput.type = 'text';
                eyeIcon.className = 'fa-solid fa-eye-slash';
            } else {
                keyInput.type = 'password';
                eyeIcon.className = 'fa-solid fa-eye';
            }
        }

        function saveApiKey() {
            const key = document.getElementById('user-api-key').value.trim();
            const provider = document.getElementById('api-provider').value;
            if(!key) {
                showModal("API Key Kosong", "Silakan masukkan API Key yang valid.");
                return;
            }
            localStorage.setItem('arena_api_key', key);
            localStorage.setItem('arena_api_provider', provider);
            updateKeyStatusBadge(true);
            toggleKeyModal();
            showModal("Berhasil Disimpan", "API Key berhasil tersimpan aman di peramban Anda.", "success");
        }

        function clearApiKey() {
            localStorage.removeItem('arena_api_key');
            document.getElementById('user-api-key').value = '';
            updateKeyStatusBadge(false);
            toggleKeyModal();
            showModal("API Key Dihapus", "API Key telah dihapus dari peramban.", "success");
        }

        function updateKeyStatusBadge(isSet) {
            const btn = document.getElementById('key-status-btn');
            const text = document.getElementById('key-status-text');
            if(isSet) {
                btn.className = "text-xs bg-brand-500/10 text-brand-400 border border-brand-500/40 px-3 py-2 rounded-xl font-medium transition flex items-center space-x-2";
                text.innerText = "API Key Aktif";
            } else {
                btn.className = "text-xs bg-slate-900 text-amber-400 border border-amber-500/40 px-3 py-2 rounded-xl font-medium transition flex items-center space-x-2";
                text.innerText = "Set API Key";
            }
        }

        function setSport(sportName) {
            currentSport = sportName;
            document.querySelectorAll('.sport-btn').forEach(btn => {
                btn.className = "sport-btn p-3 rounded-xl border border-slate-800 bg-slate-900/60 text-slate-400 hover:border-slate-700 flex flex-col items-center justify-center space-y-1.5 transition font-medium text-xs";
            });
            
            const activeBtn = document.getElementById(`sport-${sportName.replace(/\s+/g, '-')}`);
            if(activeBtn) {
                activeBtn.className = "sport-btn p-3 rounded-xl border border-brand-500 bg-brand-500/10 text-brand-300 flex flex-col items-center justify-center space-y-1.5 transition font-medium text-xs shadow-sm";
            }
            
            document.getElementById('current-sport-badge').innerText = sportName;

            const drawContainer = document.getElementById('container-draw');
            if (sportName === 'Basket') {
                drawContainer.style.display = 'none';
            } else {
                drawContainer.style.display = 'block';
            }
        }

        function loadPreset(type) {
            if(type === 'football') {
                setSport('Sepak Bola');
                document.getElementById('teamA').value = 'Real Madrid';
                document.getElementById('teamB').value = 'Barcelona';
                document.getElementById('matchLocation').value = 'Kandang Tim A';
                document.getElementById('h2h').value = '3 Menang Real Madrid, 1 Seri, 1 Menang Barcelona';
                document.getElementById('formA').value = 'M-M-M-S-M';
                document.getElementById('formB').value = 'M-S-K-M-M';
                document.getElementById('injuries').value = 'Gavi (Barcelona) absen, Courtois kembali fit';
                document.getElementById('notes').value = 'El Clasico di Santiago Bernabeu, intensitas tinggi';
            }
        }

        function showModal(title, message, type = 'warning') {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-message').innerText = message;
            const iconDiv = document.getElementById('modal-icon');
            if(type === 'success') {
                iconDiv.className = "w-12 h-12 bg-brand-500/20 text-brand-400 rounded-2xl mx-auto flex items-center justify-center text-xl border border-brand-500/30";
                iconDiv.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
            } else {
                iconDiv.className = "w-12 h-12 bg-amber-500/20 text-amber-400 rounded-2xl mx-auto flex items-center justify-center text-xl border border-amber-500/30";
                iconDiv.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i>';
            }
            document.getElementById('custom-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('custom-modal').classList.add('hidden');
        }

        async function analyzeWithAI() {
            const teamA = document.getElementById('teamA').value.trim();
            const teamB = document.getElementById('teamB').value.trim();
            const location = document.getElementById('matchLocation').value;
            const h2h = document.getElementById('h2h').value.trim();
            const formA = document.getElementById('formA').value.trim();
            const formB = document.getElementById('formB').value.trim();
            const injuries = document.getElementById('injuries').value.trim();
            const notes = document.getElementById('notes').value.trim();

            // Strict Validation
            if(!teamA || !teamB) {
                showModal("Data Belum Lengkap", "Mohon isi nama Tim/Pemain A dan Tim/Pemain B agar analisis tidak spekulatif.");
                return;
            }

            const apiKey = localStorage.getItem('arena_api_key');
            const provider = localStorage.getItem('arena_api_provider') || 'gemini';

            // Show Loading State
            document.getElementById('result-placeholder').classList.add('hidden');
            document.getElementById('result-container').classList.add('hidden');
            document.getElementById('result-loading').classList.remove('hidden');

            // Construct structured prompt
            const systemPrompt = `Anda adalah seorang analis olahraga profesional bereputasi tinggi. Tugas Anda adalah menganalisis pertandingan olahraga dan memberikan estimasi skor serta peluang hasil pertandingan berdasarkan data realistis yang diberikan.
Output HARUS berformat JSON murni tanpa markdown triple backticks.
Format JSON harus persis seperti struktur ini:
{
  "score": "2 - 1",
  "probA": 55,
  "probDraw": 20,
  "probB": 25,
  "confidence": 80,
  "keyFactors": [
    "Faktor 1...",
    "Faktor 2...",
    "Faktor 3..."
  ],
  "narrative": "Analisis ringkas taktik dan kondisi kedua tim..."
}`;

            const userPrompt = `Analisis Pertandingan Olahraga:
- Cabang Olahraga: ${currentSport}
- Tim/Pemain A: ${teamA}
- Tim/Pemain B: ${teamB}
- Lokasi Pertandingan: ${location}
- Rekor H2H: ${h2h || 'Tidak ada data'}
- Performa 5 Laga Terakhir Tim A: ${formA || 'Tidak ada data'}
- Performa 5 Laga Terakhir Tim B: ${formB || 'Tidak ada data'}
- Kondisi Cedera/Pemain: ${injuries || 'Tidak ada catatan'}
- Catatan Taktis Tambahan: ${notes || 'Tidak ada'}

Berikan hasil estimasi objektif dan ilmiah dalam JSON murni. (Untuk Basket, probDraw diisi 0).`;

            try {
                let aiResult = null;

                if (apiKey) {
                    // Make direct call using user provided API key
                    if (provider === 'gemini') {
                        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
                        const response = await fetch(apiUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                contents: [{ parts: [{ text: userPrompt }] }],
                                systemInstruction: { parts: [{ text: systemPrompt }] },
                                generationConfig: { responseMimeType: "application/json" }
                            })
                        });
                        const data = await response.json();
                        const jsonText = data.candidates?.[0]?.content?.parts?.[0]?.text;
                        aiResult = JSON.parse(jsonText);
                    } else { // OpenAI
                        const apiUrl = `https://api.openai.com/v1/chat/completions`;
                        const response = await fetch(apiUrl, {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${apiKey}`
                            },
                            body: JSON.stringify({
                                model: "gpt-4o-mini",
                                response_format: { type: "json_object" },
                                messages: [
                                    { role: "system", content: systemPrompt },
                                    { role: "user", content: userPrompt }
                                ]
                            })
                        });
                        const data = await response.json();
                        aiResult = JSON.parse(data.choices[0].message.content);
                    }
                } else {
                    // Fallback built-in API model integration if user hasn't set custom key yet
                    const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=`;
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            contents: [{ parts: [{ text: userPrompt }] }],
                            systemInstruction: { parts: [{ text: systemPrompt }] },
                            generationConfig: { responseMimeType: "application/json" }
                        })
                    });
                    const data = await response.json();
                    const jsonText = data.candidates?.[0]?.content?.parts?.[0]?.text;
                    aiResult = JSON.parse(jsonText);
                }

                renderResults(aiResult, teamA, teamB);

            } catch (error) {
                console.error(error);
                document.getElementById('result-loading').classList.add('hidden');
                document.getElementById('result-placeholder').classList.remove('hidden');
                showModal("Gagal Mengontak AI", "Terjadi kesalahan saat memproses data analisis dengan API. Periksa API Key atau koneksi Anda.");
            }
        }

        function renderResults(res, teamA, teamB) {
            document.getElementById('result-loading').classList.add('hidden');
            document.getElementById('result-container').classList.remove('hidden');

            document.getElementById('res-sport-tag').innerText = currentSport;
            document.getElementById('res-match-title').innerText = `${teamA} vs ${teamB}`;
            document.getElementById('res-teamA-name').innerText = teamA;
            document.getElementById('res-teamB-name').innerText = teamB;
            document.getElementById('res-score').innerText = res.score || "1 - 0";

            // Probabilities
            const pA = res.probA || 50;
            const pDraw = currentSport === 'Basket' ? 0 : (res.probDraw || 20);
            const pB = res.probB || (100 - pA - pDraw);

            document.getElementById('prob-val-A').innerText = pA + '%';
            document.getElementById('bar-A').style.width = pA + '%';
            document.getElementById('prob-label-A').innerText = `Menang ${teamA}`;

            if(currentSport === 'Basket') {
                document.getElementById('container-draw').style.display = 'none';
            } else {
                document.getElementById('container-draw').style.display = 'block';
                document.getElementById('prob-val-Draw').innerText = pDraw + '%';
                document.getElementById('bar-Draw').style.width = pDraw + '%';
            }

            document.getElementById('prob-val-B').innerText = pB + '%';
            document.getElementById('bar-B').style.width = pB + '%';
            document.getElementById('prob-label-B').innerText = `Menang ${teamB}`;

            document.getElementById('confidence-badge').innerText = `Tingkat Keyakinan: ${res.confidence || 75}%`;

            // Key Factors
            const factorsList = document.getElementById('key-factors-list');
            factorsList.innerHTML = '';
            (res.keyFactors || []).forEach(factor => {
                const li = document.createElement('li');
                li.className = 'flex items-start';
                li.innerHTML = `<i class="fa-solid fa-check text-brand-500 mt-0.5 mr-1.5 flex-shrink-0"></i><span>${factor}</span>`;
                factorsList.appendChild(li);
            });

            // Narrative
            document.getElementById('res-narrative').innerText = `"${res.narrative || 'Analisis menunjukkan persaingan ketat.'}"`;

            if(window.innerWidth < 1024) {
                document.getElementById('result-container').scrollIntoView({ behavior: 'smooth' });
            }
        }

        function resetForm() {
            document.getElementById('teamA').value = '';
            document.getElementById('teamB').value = '';
            document.getElementById('h2h').value = '';
            document.getElementById('formA').value = '';
            document.getElementById('formB').value = '';
            document.getElementById('injuries').value = '';
            document.getElementById('notes').value = '';
            
            document.getElementById('result-placeholder').classList.remove('hidden');
            document.getElementById('result-loading').classList.add('hidden');
            document.getElementById('result-container').classList.add('hidden');
        }
    </script>
</body>
</html>
